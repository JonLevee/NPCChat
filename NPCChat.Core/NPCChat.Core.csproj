<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
		<PackageReference Include="System.Text.Json" Version="9.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
		<PackageReference Include="System.Threading.Channels" Version="10.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
		<PackageReference Include="YamlDotNet" Version="17.0.1" />
	</ItemGroup>

	<Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<ItemGroup>
			<UnityPluginFiles Include="$(OutputPath)*.dll" />
			<UnityPluginFiles Include="$(OutputPath)*.pdb" />
			<UnityPluginFiles Include="$(OutputPath)*.json" />
		</ItemGroup>
		<Copy SourceFiles="@(UnityPluginFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\NPCChat.Unity\Assets\Plugins" SkipUnchangedFiles="true" />
		<ItemGroup>
			<UnityDataFiles Include="$(ProjectDir)\Data\*.yaml" />
		</ItemGroup>
		<Copy SourceFiles="@(UnityDataFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\NPCChat.Unity\Assets\StreamingAssets\Data" SkipUnchangedFiles="true" />
	</Target>
</Project>

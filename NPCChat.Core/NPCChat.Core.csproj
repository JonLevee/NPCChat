<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
		<PackageReference Include="System.Text.Json" Version="9.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
		<PackageReference Include="System.Threading.Channels" Version="10.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
		<PackageReference Include="YamlDotNet" Version="17.0.1" />
	</ItemGroup>

	<Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<ItemGroup>
			<UnityPluginFiles Include="$(OutputPath)*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(UnityPluginFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\NPCChat.Unity\NPCGame\Assets\Plugins" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="set outDir=$(OutDir)&#xD;&#xA;set outDir=%25outdir:~0,-1%25&#xD;&#xA;set solutionDir=$(SolutionDir)&#xD;&#xA;&#xD;&#xA;set source=%25CD%25\%25OutDir%25&#xD;&#xA;set target=%25SolutionDir%25NPCChat.Unity\Assets\Plugins&#xD;&#xA;&#xD;&#xA;IF &quot;%25outdir:~-14%25&quot;==&quot;netstandard2.1&quot; (&#xD;&#xA;  robocopy &quot;%25source%25&quot; &quot;%25target%25&quot; /s &#xD;&#xA;)&#xD;&#xA;exit /b 0&#xD;&#xA;" />
	</Target>

</Project>

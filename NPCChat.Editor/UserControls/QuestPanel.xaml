<UserControl x:Class="NPCChat.Editor.UserControls.QuestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="300"
             Visibility="Collapsed">

    <Border Background="#CC0D1B2A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            MinWidth="200">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="Quests"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#34D399"
                       Margin="0,0,0,8" />

            <!-- Quest list -->
            <ItemsControl x:Name="QuestList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <!-- Quest name -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F1F5F9" />
                            <!-- Objectives -->
                            <ItemsControl ItemsSource="{Binding Objectives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,1,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Description}"
                                                       FontSize="10"
                                                       Foreground="{Binding ProgressColor}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProgressText}"
                                                       FontSize="10"
                                                       Foreground="{Binding ProgressColor}"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty message -->
            <TextBlock x:Name="EmptyText"
                       Text="No active quests"
                       FontSize="11"
                       Foreground="#475569"
                       Visibility="Collapsed" />

            <!-- Hint -->
            <TextBlock Text="J to close"
                       FontSize="10"
                       Foreground="#475569"
                       Margin="0,8,0,0" />

        </StackPanel>
    </Border>
</UserControl>

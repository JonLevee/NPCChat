<Window x:Class="NPCChat.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:NPCChat.Editor.UserControls"
        mc:Ignorable="d"
        Title="NPCChat Sandbox"
        Height="900"
        Width="1400"
        Background="#0B1220"
        Foreground="White"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="12,12,12,6">

            <Button x:Name="StartStopButton"
                    Content="Start"
                    Margin="0,0,12,0"
                    Padding="12,6"
                    Click="StartStopButton_Click"
                    />

            <Button x:Name="BuildDemoTownButton"
                    Content="Build Demo"
                    Click="BuildDemoTownButton_Click"
                    Margin="0,0,12,0"
                    Padding="12,6">
            </Button>

            <Button x:Name="RedrawButton"
                    Content="Redraw"
                    Click="RedrawButton_Click"
                    Margin="0,0,12,0"
                    Padding="12,6" />

            <TextBlock Text="Cell Size:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox x:Name="CellSizeListBox"
                     Width="60"
                     VerticalAlignment="Center"
                     SelectionChanged="CellSizeListBox_SelectionChanged" HorizontalAlignment="Center" IsReadOnly="True">
            </ComboBox>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Padding="10,8"
                CornerRadius="8"
                BorderBrush="#334155"
                BorderThickness="1"
                Background="#0F172A">
            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          Margin="12,0,4,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WorldObjectPanel"
                            Orientation="Vertical" />
            </ScrollViewer>

            <!-- Map area + dialogue overlay in the same cell -->
            <Grid Grid.Column="1" Margin="4,0,12,12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Border BorderBrush="#334155"
                            BorderThickness="1"
                            Background="#111827"
                            Padding="8">
                        <Canvas
                            x:Name="MapCanvas"
                            MouseUp="MapCanvas_MouseUp"
                            MouseMove="MapCanvas_MouseMove"
                            MouseRightButtonUp="MapCanvas_MouseRightButtonUp"
                            />
                    </Border>
                </ScrollViewer>

                <!-- Dialogue panel — floats over the map at the bottom -->
                <uc:DialoguePanel x:Name="DialoguePanelControl"
                                  VerticalAlignment="Bottom"
                                  Panel.ZIndex="20" />

                <!-- Inventory panel — floats over the map at the top-right -->
                <uc:InventoryPanel x:Name="InventoryPanelControl"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,8,0"
                                   Panel.ZIndex="20" />

                <!-- Quest panel — floats over the map at the top-left -->
                <uc:QuestPanel x:Name="QuestPanelControl"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               Margin="8,8,0,0"
                               Panel.ZIndex="20" />
            </Grid>
        </Grid>
    </Grid>
</Window>
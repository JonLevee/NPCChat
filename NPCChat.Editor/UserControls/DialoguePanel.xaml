<UserControl x:Class="NPCChat.Editor.UserControls.DialoguePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="180"
             Visibility="Collapsed">

    <Border Background="#CC0D1B2A"
            BorderBrush="#334155"
            BorderThickness="1,1,1,0"
            CornerRadius="8,8,0,0"
            Padding="16,12,16,14"
            MaxWidth="700"
            HorizontalAlignment="Center">
        <StackPanel>

            <!-- NPC name -->
            <TextBlock x:Name="NpcNameText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#F59E0B"
                       Margin="0,0,0,6" />

            <!-- NPC speech / pool line -->
            <TextBlock x:Name="SpeechText"
                       FontSize="13"
                       Foreground="#E2E8F0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- Choice list (PlayerChoice state only) -->
            <ItemsControl x:Name="ChoicesList"
                          Visibility="Collapsed"
                          Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   Foreground="#93C5FD"
                                   Margin="0,1,0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hint -->
            <TextBlock x:Name="HintText"
                       FontSize="10"
                       Foreground="#475569" />

        </StackPanel>
    </Border>
</UserControl>

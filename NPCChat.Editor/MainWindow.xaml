<Window x:Class="NPCChat.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:NPCChat.Editor.UserControls"
        mc:Ignorable="d"
        Title="NPCChat Sandbox"
        Height="900"
        Width="1400"
        Background="#0B1220"
        Foreground="White">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="12,12,12,6">

            <uc:FlipButton x:Name="CreateGameButton"
                           Margin="0,0,12,0"
                           Padding="12,6"
                           PrimaryCommand="{Binding ElementName=RootWindow, Path=CreateWorldScopeCommand}"
                           SecondaryCommand="{Binding ElementName=RootWindow, Path=ClearWorldScopeCommand}">
                <uc:FlipButtonState Key="Create" Text="Game: Create" />
                <uc:FlipButtonState Key="Clear" Text="Game: Clear" />
            </uc:FlipButton>

            <uc:FlipButton x:Name="BuildDemoTownButton"
                           Margin="0,0,12,0"
                           Padding="12,6"
                           PrimaryCommand="{Binding ElementName=RootWindow, Path=BuildDemoTownCommand}"
                           SecondaryCommand="{Binding ElementName=RootWindow, Path=ClearDemoTownCommand}">
                <uc:FlipButtonState Key="Build" Text="Town: Build Demo" />
                <uc:FlipButtonState Key="Clear" Text="Town: Clear" />
            </uc:FlipButton>

            <Button x:Name="RedrawButton"
                    Content="Redraw"
                    Command="{Binding RedrawCommand}"
                    Margin="0,0,12,0"
                    Padding="12,6" />

            <TextBlock Text="Cell Size:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <TextBox x:Name="CellSizeBox"
                     Width="90"
                     Text="24"
                     VerticalContentAlignment="Center"
                     TextChanged="CellSizeBox_TextChanged" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Padding="10,8"
                CornerRadius="8"
                BorderBrush="#334155"
                BorderThickness="1"
                Background="#0F172A">
            <TextBlock x:Name="StatusTextBlock"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="12,0,12,12"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="#334155"
                    BorderThickness="1"
                    Background="#111827"
                    Padding="8">
                <Canvas x:Name="MapCanvas" />
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NPCChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NPCChat"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NPCChat Sandbox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" RowDefinitions="Auto,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,12,12,6">
            <Button Content="Build Demo Town" Click="BuildDemoTown_Click" />
            <Button Content="Redraw" Click="Redraw_Click" />
            <TextBlock Text="Cell Size:" VerticalAlignment="Center" />
            <NumberBox x:Name="CellSizeBox"
                       Width="90"
                       Minimum="8"
                       Maximum="64"
                       SmallChange="2"
                       LargeChange="4"
                       Value="24"
                       SpinButtonPlacementMode="Compact"
                       ValueChanged="CellSizeBox_ValueChanged" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Padding="10,8"
                CornerRadius="8"
                BorderBrush="#334155"
                BorderThickness="1"
                Background="#0F172A">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready."
                       TextWrapping="WrapWholeWords" />
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="12,0,12,12"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ZoomMode="Disabled">
            <Border BorderBrush="#334155"
                    BorderThickness="1"
                    Background="#111827"
                    Padding="8">
                <Canvas x:Name="MapCanvas" />
            </Border>
        </ScrollViewer>
    </Grid>
</Window>

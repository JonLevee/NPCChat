<UserControl x:Class="NPCChat.Editor.UserControls.ShopPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="380"
             Visibility="Collapsed">

    <Border Background="#CC0D1B2A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            MinWidth="240">
        <StackPanel>

            <!-- Title -->
            <TextBlock x:Name="ShopTitle"
                       Text="Shop"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#F59E0B"
                       Margin="0,0,0,8" />

            <!-- Tab buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="BuyTabButton"
                        Content="Buy"
                        Padding="10,3"
                        Margin="0,0,6,0"
                        FontSize="11"
                        Click="BuyTab_Click" />
                <Button x:Name="SellTabButton"
                        Content="Sell"
                        Padding="10,3"
                        FontSize="11"
                        Click="SellTab_Click" />
            </StackPanel>

            <!-- ── Buy panel ─────────────────────────────────────── -->
            <StackPanel x:Name="BuyPanel">

                <ListBox x:Name="BuyList"
                         MaxHeight="180"
                         Background="Transparent"
                         BorderBrush="#334155"
                         Foreground="#CBD5E1"
                         FontSize="11"
                         Margin="0,0,0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PriceText}"
                                           Foreground="#F59E0B"
                                           Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Buy 1"
                        Padding="10,4"
                        FontSize="11"
                        HorizontalAlignment="Left"
                        Click="BuyButton_Click" />

            </StackPanel>

            <!-- ── Sell panel ────────────────────────────────────── -->
            <StackPanel x:Name="SellPanel" Visibility="Collapsed">

                <ListBox x:Name="SellList"
                         MaxHeight="180"
                         Background="Transparent"
                         BorderBrush="#334155"
                         Foreground="#CBD5E1"
                         FontSize="11"
                         Margin="0,0,0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding QtyText}"
                                           Foreground="#64748B"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SellPriceText}"
                                           Foreground="#34D399"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Sell 1"
                        Padding="10,4"
                        FontSize="11"
                        HorizontalAlignment="Left"
                        Click="SellButton_Click" />

            </StackPanel>

            <!-- Gold and hint -->
            <TextBlock x:Name="GoldLabel"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Foreground="#F59E0B" />

            <TextBlock Text="Esc to close"
                       FontSize="10"
                       Foreground="#475569"
                       Margin="0,4,0,0" />

        </StackPanel>
    </Border>
</UserControl>
